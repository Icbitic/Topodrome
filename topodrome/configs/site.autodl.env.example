# Install as /root/autodl-fs/topodrome/secrets/site.env with mode 0600.
# Supply new deployment-specific values; never copy credentials from this
# repository or from an operator's shell history.
TOPODROME_SITE_ENROLLMENT_TOKEN=
TOPODROME_SITE_FENCE_VERIFICATION_KEY=
TOPODROME_HF_TOKEN=
RCLONE_CONFIG=/root/autodl-fs/topodrome/secrets/rclone.conf
